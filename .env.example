# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# Only DATABASE_URL is actually read by the app/Prisma. DB_HOST/DB_PORT/DB_SCHEMA/
# DB_USER/DB_PASSWORD/DB_NAME below are informational building blocks for
# constructing it by hand -- dotenv does NOT expand ${VAR} references, so they
# are not substituted automatically.
DB_HOST=localhost
DB_PORT=3306
DB_SCHEMA=public
DB_USER=root
DB_PASSWORD=
DB_NAME=berrylistings

DATABASE_URL=mysql://root:password@localhost:3306/berrylistings

# Seeds the first admin User row (via `npm run db:seed`). ADMIN_PASS is
# currently unused -- there is no password-based auth in this app.
ADMIN_USER=admin@example.com
ADMIN_PASS=

# Signs/verifies bearer JWTs. Use a long, random value in any real environment.
JWT_SECRET=

# OAuth 2.0 Client ID from a Google Cloud project (APIs & Services > Credentials).
# Used to verify Google ID tokens on POST /api/v1/auth/google.
GOOGLE_CLIENT_ID=
